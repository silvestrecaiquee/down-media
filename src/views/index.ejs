<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>YouTube Downloader de vídeo</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        /* Estilização da scrollbar */
        .scrollbar-thin::-webkit-scrollbar {
            width: 6px;
        }
        
        .scrollbar-thin::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 3px;
        }
        
        .scrollbar-thin::-webkit-scrollbar-thumb {
            background: #d1d5db;
            border-radius: 3px;
        }
        
        .scrollbar-thin::-webkit-scrollbar-thumb:hover {
            background: #9ca3af;
        }

        /* Loading Spinner */
        .spinner {
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            from {
                transform: rotate(0deg);
            }
            to {
                transform: rotate(360deg);
            }
        }

        /* Skeleton Loading Animation */
        .animate-pulse {
            animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        }

        @keyframes pulse {
            0%, 100% {
                opacity: 1;
            }
            50% {
                opacity: .5;
            }
        }
    </style>
</head>
<body class="bg-gray-100 min-h-screen">
    <div class="container mx-auto px-4 py-8">
        <h1 class="text-4xl font-bold text-center mb-8">YouTube Downloader de vídeo</h1>
        
        <div class="max-w-3xl mx-auto bg-white rounded-lg shadow-md p-6">
            <% if (error) { %>
                <div class="mb-4 p-4 bg-red-100 border border-red-400 text-red-700 rounded-lg">
                    <%= error %>
                </div>
            <% } %>

            <form id="downloadForm" class="space-y-6">
                <div class="relative">
                    <label for="video-url" class="block text-sm font-medium text-gray-700 mb-2">Colar link do vídeo</label>
                    <input 
                        type="url" 
                        id="video-url" 
                        name="url" 
                        placeholder="https://www.youtube.com/watch?v=..."
                        class="w-full px-4 py-3 rounded-[45px] border outline-none border-gray-300 focus:ring-2 focus:ring-purple-600 focus:border-transparent"
                        required
                    >
                    <button type="button" onclick="getVideoInfo()" class="absolute right-2 top-[33px] bg-purple-600 text-white p-2 rounded-full hover:bg-purple-700">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>
                    </button>
                </div>
            </form>
        </div>

        <div id="loading" class="hidden max-w-3xl mx-auto mt-8 bg-white rounded-lg shadow-md p-6">
            <div class="flex justify-center items-center mb-4">
                <svg class="spinner w-8 h-8 text-purple-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                <span class="ml-2 text-gray-700">Buscando informações do vídeo...</span>
            </div>
            <!-- Skeleton Loading -->
            <div class="flex flex-col md:flex-row gap-6 animate-pulse">
                <div class="md:w-1/3">
                    <div class="aspect-video bg-gray-200 rounded-lg"></div>
                </div>
                <div class="md:w-2/3 space-y-4">
                    <div class="h-8 bg-gray-200 rounded w-3/4"></div>
                    <div class="space-y-2">
                        <div class="h-4 bg-gray-200 rounded w-1/2"></div>
                        <div class="h-4 bg-gray-200 rounded w-1/3"></div>
                    </div>
                    <div class="mt-4">
                        <div class="h-4 bg-gray-200 rounded w-1/4 mb-2"></div>
                        <div class="bg-gray-50 p-4 rounded-lg space-y-4">
                            <div class="h-10 bg-gray-200 rounded"></div>
                            <div class="h-12 bg-gray-200 rounded"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div id="video-content">
            <!-- O conteúdo do vídeo será inserido aqui dinamicamente -->
        </div>

        <% if (title) { %>
            <div class="max-w-3xl mx-auto mt-8 bg-white rounded-lg shadow-md p-6">
                <div class="flex flex-col md:flex-row gap-6">
                    <!-- Thumbnail e Informações Básicas -->
                    <div class="md:w-1/3 relative">
                        <% if (thumbnail) { %>
                            <div class="relative aspect-video">
                                <img src="<%= thumbnail %>" alt="<%= title %>" class="absolute inset-0 w-full h-full object-contain rounded-lg">
                                <% if (lengthSeconds) { %>
                                    <div class="absolute bottom-2 right-2 bg-black bg-opacity-75 text-white px-2 py-1 rounded text-sm">
                                        <%= formattedDuration %>
                                    </div>
                                <% } %>
                            </div>
                        <% } %>
                    </div>
                    
                    <div class="md:w-2/3 space-y-4">
                        <h2 class="text-2xl font-bold text-gray-800"><%= title %></h2>
                        
                        <div class="space-y-2">
                            <p class="text-gray-600">
                                <span class="font-medium">Autor:</span> <%= author.name %>
                            </p>
                            <% if (publishDate) { %>
                                <p class="text-gray-600">
                                    <span class="font-medium">Data de Publicação:</span> 
                                    <%= new Date(publishDate).toLocaleDateString('pt-BR') %>
                                </p>
                            <% } %>
                        </div>

                        <!-- Formatos Disponíveis -->
                        <% if (availableFormats && availableFormats.length > 0) { %>
                            <div class="mt-4">
                                <h3 class="text-lg font-medium text-gray-800 mb-2">Formatos Disponíveis:</h3>
                                <div class="bg-gray-50 p-4 rounded-lg space-y-4">
                                    <select name="format" class="w-full bg-white border border-gray-300 rounded-md py-2 px-3 focus:outline-none focus:ring-2 focus:ring-purple-600">
                                        <% if (availableFormats && availableFormats.length > 0) { %>
                                            <% availableFormats.forEach(format => { %>
                                                <option value='<%= JSON.stringify(format) %>'><%= QualityTypeLabel[format.qualityLabel] %></option>
                                            <% }); %>
                                        <% } %> 
                                    </select>
                                    <button 
                                        onclick="downloadVideo()"
                                        class="w-full bg-purple-600 text-white py-3 px-6 rounded-lg font-medium hover:bg-purple-700 transition-colors"
                                    >
                                        Download
                                    </button>
                                    <button 
                                        onclick="window.location.href='/'"
                                        class="w-full bg-white border border-gray-300 text-gray-700 py-3 px-6 rounded-lg font-medium hover:bg-gray-50 transition-colors"
                                    >
                                        Redefinir
                                    </button>
                                </div>
                            </div>
                        <% } %>

                        <!-- Vídeos Relacionados -->
                        <% if (relatedVideos && relatedVideos.length > 0) { %>
                            <div class="mt-6">
                                <h3 class="text-lg font-medium text-gray-800 mb-3">Vídeos Recomendados:</h3>
                                <div class="max-h-[400px] overflow-y-auto pr-2 space-y-2 scrollbar-thin scrollbar-thumb-gray-300 scrollbar-track-gray-100">
                                    <% relatedVideos.forEach(video => { %>
                                        <div 
                                            onclick="window.location.href='/?url=https://www.youtube.com/watch?v=<%= video.id %>'"
                                            class="flex items-start gap-3 p-2 hover:bg-gray-50 rounded-lg cursor-pointer transition-colors"
                                        >
                                            <% if (video.thumbnails && video.thumbnails[0]) { %>
                                                <div class="relative w-[160px] h-[90px] flex-shrink-0">
                                                    <img src="<%= video.thumbnails[0].url %>" alt="<%= video.title %>" class="absolute inset-0 w-full h-full object-contain rounded-lg">
                                                    <% if (video.length_seconds) { %>
                                                        <div class="absolute bottom-1 right-1 bg-black bg-opacity-75 text-white px-1 py-0.5 rounded text-[10px]">
                                                            <%= getFormatDuration(parseInt(video.length_seconds)) %>
                                                        </div>
                                                    <% } %>
                                                </div>
                                            <% } %>
                                            <div class="flex-1 min-w-0">
                                                <p class="text-sm font-medium text-gray-800 line-clamp-2"><%= video.title %></p>
                                                <p class="text-xs text-gray-600 mt-1"><%= video.author.name %></p>
                                            </div>
                                        </div>
                                    <% }); %>
                                </div>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        <% } %>
    </div>

    <script src="/js/main.js"></script>
</body>
</html>
